# Smilepayz environment: sandbox | production
SMILEPAYZ_ENV=sandbox

# Optional override. If omitted, sandbox/production URLs from Smilepayz docs are used.
# sandbox: https://sandbox-gateway.smilepayz.com
# production: https://gateway.smilepayz.com
SMILEPAYZ_BASE_URL=

# Partner / merchant credentials (active environment)
SMILEPAYZ_PARTNER_ID=
SMILEPAYZ_MERCHANT_SECRET=
SMILEPAYZ_MERCHANT_NAME=

# RSA keys: prefer file paths on the server. NEVER commit real keys.
SMILEPAYZ_PRIVATE_KEY_PATH=/etc/smilepayz/keys/smilepayz-private.pem
SMILEPAYZ_PUBLIC_KEY_PATH=/etc/smilepayz/keys/smilepayz-public.pem
SMILEPAYZ_PRIVATE_KEY=
SMILEPAYZ_PLATFORM_PUBLIC_KEY=

# Optional environment-specific overrides
SMILEPAYZ_SANDBOX_PARTNER_ID=
SMILEPAYZ_SANDBOX_MERCHANT_SECRET=
SMILEPAYZ_SANDBOX_PRIVATE_KEY=
SMILEPAYZ_SANDBOX_PLATFORM_PUBLIC_KEY=

SMILEPAYZ_PRODUCTION_PARTNER_ID=
SMILEPAYZ_PRODUCTION_MERCHANT_SECRET=
SMILEPAYZ_PRODUCTION_PRIVATE_KEY=
SMILEPAYZ_PRODUCTION_PLATFORM_PUBLIC_KEY=

# Balance inquiry account numbers (Merchant Portal)
SMILEPAYZ_ACCOUNT_NO=
SMILEPAYZ_PAYIN_ACCOUNT_NO=
SMILEPAYZ_PAYOUT_ACCOUNT_NO=

# Optional defaults
SMILEPAYZ_PAYMENT_METHOD=CASHIER_IN
SMILEPAYZ_PAYOUT_PAYMENT_METHOD=
SMILEPAYZ_EXPIRY_PERIOD=3600

# Callbacks (must be HTTPS in production)
NOTIFY_URL=https://smilepayz.rollix777.com/api/payment/webhook
PAYOUT_NOTIFY_URL=https://smilepayz.rollix777.com/api/payout/webhook
RETURN_URL=https://r7dream.com/

# HTTP
PORT=3000
NODE_ENV=development
REQUEST_TIMEOUT_MS=15000
BALANCE_RETRY_COUNT=1
ALLOWED_ORIGINS=*

# Database (same recharge / withdrawl tables as Skillpay)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=skillpay
DB_PORT=3306

# Rollix platform APIs used after successful pay-in callback
PLATFORM_BASE_URL=https://api.rollix777.com
